integration/.env
integration/volumes/
integration/e2e/node_modules/
integration/e2e/test-results/
integration/e2e/playwright-report/

# act runs (integration/scripts/ci.sh)
integration/.act/

# load-test raw output (regenerated by integration/scripts/load.sh run)
integration/load/out/
integration/load/__pycache__/

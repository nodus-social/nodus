# syntax=docker/dockerfile:1

# One image that runs a complete Nodus instance: Postgres, the server, the
# server-rendered shell and the client bundle, behind one Caddy listener.
#
#   docker build -f deploy/docker/Dockerfile.aio -t nodus-aio:0.1.0 .
#   docker run -p 8080:8080 -e NODUS_DOMAIN=nodus.example -e NODUS_BASE_URL=https://nodus.example \
#     -v nodus-data:/var/lib/nodus nodus-aio:0.1.0
#
# The binary stages build on bookworm because the runtime is bookworm; the bundle stage needs
# node and trunk, and its output is wasm, which has no libc to mismatch.
#
# Each service is its own binary. The image starts all of them in one container, but nothing
# in the build assumes that: a spread-out deployment takes one binary per unit.

ARG RUST_VERSION=1-bookworm

FROM rust:${RUST_VERSION} AS server
WORKDIR /src
# Every tree in the repository is in one Cargo dependency graph: the server reaches the SDKs
# by path and mounts the recommendation engine in process, the shell reaches the SDK and the
# service transport. Copying the context once keeps every stage resolvable whatever a
# manifest names next; `.dockerignore` decides what that context contains.
COPY . /src
WORKDIR /src/nodus-backend
RUN cargo build --release --locked \
      --bin nodus-api --bin nodus-media --bin nodus-feed --bin nodus-scan --bin nodus-prune \
      --bin nodus-calc

FROM rust:${RUST_VERSION} AS shell
WORKDIR /src
COPY . /src
WORKDIR /src/web
RUN cargo build --release --locked --bin nodus-web-server

FROM rust:${RUST_VERSION} AS bundle
# bookworm's nodejs is new enough for esbuild and tailwind; trunk is a pinned prebuilt
# release so the stage does not spend ten minutes compiling it.
ARG TRUNK_VERSION=0.22.1
# `binaryen` puts `wasm-opt` on PATH, which is where trunk looks before it downloads its
# own copy: a build must not fail because that download timed out.
RUN apt-get update \
 && apt-get install -y --no-install-recommends nodejs npm curl ca-certificates xz-utils binaryen gzip zstd \
 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL "https://github.com/trunk-rs/trunk/releases/download/v${TRUNK_VERSION}/trunk-x86_64-unknown-linux-gnu.tar.gz" \
      | tar -xz -C /usr/local/bin trunk
RUN rustup target add wasm32-unknown-unknown
WORKDIR /src
COPY . /src
WORKDIR /src/web
RUN npm ci --no-audit --no-fund --include=optional
# npm 9 drops the platform binary of @tailwindcss/oxide that the lockfile names as an
# optional dependency, so the native module is installed explicitly at the version npm
# resolved. Without it `node:path`-based tailwind 4 plugins fail to load.
RUN node -e "const {version} = require('./node_modules/@tailwindcss/oxide/package.json');\
require('child_process').execSync('npm install --no-save --no-audit --no-fund @tailwindcss/oxide-linux-x64-gnu@' + version, {stdio: 'inherit'});" 
RUN node js/build.mjs && node js/css.mjs && trunk build --release \
 && sh /src/deploy/precompress-bundle.sh /src/web/dist

FROM debian:bookworm-slim AS runtime
ENV DEBIAN_FRONTEND=noninteractive \
    PGDATA=/var/lib/postgresql/data \
    NODUS_LISTEN=unix:/var/run/app/shell.sock \
    NODUS_ASSET_DIR=/srv/nodus \
    NODUS_SESSIONS=/var/lib/nodus/sessions.json \
    NODUS_TELEMETRY=feed=unix:/var/run/app/feed-telemetry.sock,scan=unix:/var/run/app/scan.sock,prune=unix:/var/run/app/prune.sock,calc=unix:/var/run/app/calc.sock \
    NODUS_DATABASE_URL=postgres://nodus@127.0.0.1/nodus \
    NODUS_MEDIA_DIR=/var/lib/nodus/media \
    NODUS_MEDIA_VARIANTS_DIR=/var/lib/nodus/media/variants

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      postgresql-15 caddy curl ca-certificates tini procps \
 && rm -rf /var/lib/apt/lists/*

COPY --from=server /src/nodus-backend/target/release/nodus-api /usr/local/bin/nodus-api
COPY --from=server /src/nodus-backend/target/release/nodus-media /usr/local/bin/nodus-media
COPY --from=server /src/nodus-backend/target/release/nodus-feed /usr/local/bin/nodus-feed
COPY --from=server /src/nodus-backend/target/release/nodus-scan /usr/local/bin/nodus-scan
COPY --from=server /src/nodus-backend/target/release/nodus-prune /usr/local/bin/nodus-prune
COPY --from=server /src/nodus-backend/target/release/nodus-calc /usr/local/bin/nodus-calc
COPY --from=shell /src/web/target/release/nodus-web-server /usr/local/bin/nodus-web-server
COPY --from=bundle /src/web/dist/ /srv/nodus/
COPY deploy/docker/Caddyfile /etc/caddy/Caddyfile
# The shipped config is formatted once here instead of at every start: Caddy warns about
# an unformatted file on the first line of its log, which reads like a fault.
RUN caddy fmt --overwrite /etc/caddy/Caddyfile
COPY deploy/docker/entrypoint.sh /usr/local/bin/entrypoint

RUN useradd --system --create-home --home-dir /var/lib/nodus nodus \
 && mkdir -p /var/lib/nodus/media/variants /var/lib/nodus/caddy /run/postgresql \
 && chown -R nodus:nodus /var/lib/nodus /srv/nodus \
 && chown postgres:postgres /var/lib/postgresql /run/postgresql \
 && chmod 0755 /usr/local/bin/entrypoint

EXPOSE 8080
VOLUME ["/var/lib/nodus", "/var/lib/postgresql/data"]
HEALTHCHECK --interval=30s --timeout=3s --start-period=90s \
  CMD curl -fsS http://127.0.0.1:8080/healthz || exit 1
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint"]

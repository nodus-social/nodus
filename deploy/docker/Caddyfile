# AIO ingress: the same routing the reference deployment puts in front of the instance, so a
# single container serves the client bundle, the shell and the API on one origin.
#
# `handle` blocks are mutually exclusive and matched in the order they are written, which is
# why the two shell routes come before the `/api/*` catch-all and why the asset rule comes
# before the fallback that renders pages.

{
	# A container publishes one port; there is no name to obtain a certificate for and no
	# administrative endpoint to protect.
	admin off
	auto_https off
	storage file_system /var/lib/nodus/caddy
}

:8080 {
	encode zstd gzip

	@wasm path *.wasm
	@assets path_regexp asset \.(js|mjs|wasm|css|map|json|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2)$

	# Older mime tables do not know wasm; the browser refuses it unless it is a module.
	header @wasm Content-Type application/wasm

	# The session is the shell's own state.
	handle /api/session* {
		reverse_proxy unix//var/run/app/shell.sock
	}

	# The OAuth callback is a page in the app: the code is exchanged client-side.
	handle /oauth/callback* {
		reverse_proxy unix//var/run/app/shell.sock
	}

	# Reads the shell performs on behalf of a visitor who is not signed in.
	handle /public-api/* {
		reverse_proxy unix//var/run/app/shell.sock
	}

	# The recommendation surface is its own process with its own socket: a slow model must
	# not queue behind a request, and a restart of either must not restart the other.
	#
	# The order of these `handle` blocks is load-bearing: they are exclusive and matched top
	# to bottom, so every path listed in `@feed` is answered by the feed even though the
	# `/api/*` rule further down also matches it. `/api/v1/meta` must therefore stay out of
	# this matcher. The feed does serve the path, but with its own three names; the API
	# answers it with the instance's whole handshake, and a client reads that handshake to
	# decide which console it can draw. Omitting the path lets the later `/api/*` rule route
	# it to the API — listing it, as this file once did, reduces every client to three
	# capabilities and hides the rest of the UI.
	@feed path /api/v1/feed/* /api/v1/browse /api/v1/events /api/v1/feedback/* /api/v1/me /api/v1/sync/*
	handle @feed {
		reverse_proxy unix//var/run/app/feed.sock
	}

	# Unfurling a post for a crawler is the same engine, not a page.
	handle /s/* {
		reverse_proxy unix//var/run/app/feed.sock
	}

	handle /healthz {
		reverse_proxy unix//var/run/app/api.sock
	}

	handle /readyz {
		reverse_proxy unix//var/run/app/api.sock
	}

	# The instance's own icon and thumbnail, which the server renders rather than the bundle;
	# the asset rule below would look for them inside /srv/nodus.
	@images path /icon.svg /icon.png /favicon.ico /media/thumbnail.png
	handle @images {
		reverse_proxy unix//var/run/app/api.sock
	}

	# `flush_interval -1` is what makes an event stream arrive while it happens: the log
	# drawer stays silent through the admin API until this is off.
	# Uploaded bytes are their own process: a large file read must not queue JSON behind it.
	handle /media/* {
		reverse_proxy unix//var/run/app/media.sock
	}

	# NodeInfo 2.0 lives at the domain root, not under `/.well-known`: the discovery
	# document the API serves at `/.well-known/nodeinfo` advertises this URL, and without
	# this rule the shell's catch-all answers it with an HTML page instead of the JSON
	# document. It must be matched before the `@api` handle below, though that handle's
	# `/.well-known/*` already sends discovery to the API.
	handle /nodeinfo/* {
		reverse_proxy unix//var/run/app/api.sock
	}

	@api path /oauth/* /auth/* /users/* /inbox* /statuses/* /.well-known/* /api/*
	handle @api {
		reverse_proxy unix//var/run/app/api.sock {
			flush_interval -1
		}
	}

	# deploy/ct100/nodus.caddy is the authoritative copy of this handler: it is what
	# the CT 100 deployment loads. Keep `precompressed zstd gzip` and `Vary
	# Accept-Encoding` here in step with it, or the AIO image serves the wasm identity
	# while production serves it compressed.
	handle @assets {
		root * /srv/nodus
		header Cache-Control "public, max-age=31536000, immutable"
		# `precompressed` only sets this on the responses it encodes; without it an
		# identity response is cacheable as if it were the only variant. Deferred so it
		# replaces the encoded response's own copy instead of adding a second line.
		header {
			Vary Accept-Encoding
			defer
		}
		# The bundle ships `.zst`/`.gz` siblings next to every hashed asset. The encoder
		# above skips `application/wasm`, so without this the wasm is 6.2 MB on every
		# first visit. `precompressed` falls back to the identity file when a sibling is
		# absent, which is what keeps an un-compressed asset a slow response rather than
		# a 404.
		file_server {
			precompressed zstd gzip
		}
	}

	# Page routes are server-rendered; the app decides what to draw.
	handle {
		reverse_proxy unix//var/run/app/shell.sock {
			flush_interval -1
		}
		header Cache-Control "no-store"
	}
}

# Every knob the lab reads. `integration/scripts/up.sh` copies this file to
# integration/.env and replaces every __GENERATE__ marker with `openssl rand
# -hex 32` output on first run. .env is git-ignored; commit only this file.
#
# The lab is HTTP on purpose: NODUS_AUTH_SECURE_COOKIES is off so the browser
# keeps the session cookie, and NODUS_BASE_URL is the compose-internal name so
# federation identity stays stable when the host port changes.

COMPOSE_PROJECT_NAME=nodus-lab

# Host port for the single origin. 8080 is the lab's contract; override only
# when something else on the host already holds it.
NODUS_HTTP_PORT=8080

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------

# Role password for the `nodus` Postgres role; compose builds NODUS_DATABASE_URL
# from it.
NODUS_DB_PASSWORD=__GENERATE__

# Password for the `postgres` superuser. Only used by the init script and
# healthchecks; the app never connects as it.
POSTGRES_PASSWORD=__GENERATE__

# requirepass for Valkey. Hex only (the URL is assembled in compose).
VALKEY_PASSWORD=__GENERATE__

# 32 random bytes. Publishes the drive_share capability and signs share links;
# without it POST /api/v1/drive/files/{id}/share answers 503.
NODUS_DRIVE_SHARE_SECRET=__GENERATE__

# 32 random bytes, base64. `nodus-calc` opens the OAuth tokens `nodus-feed`
# sealed; without it calc refuses to start ("TOKEN_ENC_KEY is not set").
TOKEN_ENC_KEY=__GENERATE_BASE64__

# ---------------------------------------------------------------------------
# Bootstrap admin
# ---------------------------------------------------------------------------

# Created by every service at boot when absent. The lab uses a fixed password
# so README, seed.sh and e2e agree; it is not a secret outside this machine.
NODUS_BOOTSTRAP_EMAIL=admin@nodus.test
NODUS_BOOTSTRAP_USERNAME=admin
NODUS_BOOTSTRAP_PASSWORD=nodus-lab-admin

# ---------------------------------------------------------------------------
# Identity
# ---------------------------------------------------------------------------

# The name peers and the browser are expected to use. `nodus` is a compose
# alias for Caddy, so http://nodus:8080 works inside the network and (with the
# e2e host-resolver rule) from the Playwright browser.
NODUS_DOMAIN=nodus
NODUS_BASE_URL=http://nodus:8080
NODUS_TITLE=Nodus Lab
NODUS_DESCRIPTION=A disposable Nodus instance for integration tests.
NODUS_CONTACT_EMAIL=lab@nodus.test

# ---------------------------------------------------------------------------
# Lab behaviour
# ---------------------------------------------------------------------------

# HTTP only: no TLS anywhere in the lab.
NODUS_AUTH_SECURE_COOKIES=false

# seed.sh registers ordinary accounts over the real /auth/register form.
NODUS_REGISTRATIONS_OPEN=true

# Peers live on private bridge addresses; the API only trusts hosts named here
# (comma separated, no scheme). compose.peers.yml sets this for the API; the
# core-only stack leaves it empty.
NODUS_ALLOW_PRIVATE_HOSTS=

# Unused in the single-origin lab; the peers agent may add a signing key.
NODUS_AUTHORIZED_FETCH=false

# ---------------------------------------------------------------------------
# Capacity and performance
# ---------------------------------------------------------------------------

NODUS_DATABASE_CONNECTIONS=10
NODUS_HOME_CAP=400
NODUS_HOME_SHARDS=1
NODUS_VALKEY_CHANNEL=nodus:home

# ---------------------------------------------------------------------------
# Media
# ---------------------------------------------------------------------------

# Both API and media-worker see the shared `nodus-data` volume at these paths,
# so a single node needs no media cluster URL or token.
NODUS_MEDIA_DIR=/var/lib/nodus/media
NODUS_MEDIA_VARIANTS_DIR=/var/lib/nodus/media/variants

# ---------------------------------------------------------------------------
# Federation peers (optional; scripts/peers.sh up)
# ---------------------------------------------------------------------------

# Mastodon and Misskey each own their database, so each needs its own role
# password. Nothing in the core stack reads these; peers.sh fills them on the
# first `up` and fills them into an existing .env too.
MASTODON_DB_PASSWORD=__GENERATE__
MISSKEY_DB_PASSWORD=__GENERATE__

# Mastodon refuses to boot until these three Active Record encryption keys are
# set (bin/rails db:encryption:init prints a fresh set). Ours are generated once
# per .env; they only ever encrypt this disposable database.
MASTODON_ACTIVE_RECORD_PRIMARY_KEY=__GENERATE_BASE64__
MASTODON_ACTIVE_RECORD_DETERMINISTIC_KEY=__GENERATE_BASE64__
MASTODON_ACTIVE_RECORD_KEY_DERIVATION_SALT=__GENERATE_BASE64__

# Fixed lab credentials for the seeded peer accounts. Not secrets outside this
# machine: docs/peers.md and the federation checks use them.
MASTODON_ACCOUNT_PASSWORD=lab-password-alice
MISSKEY_ACCOUNT_PASSWORD=lab-password-alice

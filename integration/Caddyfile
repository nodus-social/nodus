# The lab's single origin. Same ownership as the reference AIO ingress, with TCP
# upstreams instead of unix sockets because every service is its own container.
#
# `handle` blocks are mutually exclusive and matched in the order they are written, which
# is why the two shell routes come before the `/api/*` catch-all, why `/media/share/*`
# comes before `/media/*`, and why the asset rule comes before the page fallback.

{
	admin off
	auto_https off
	storage file_system /var/lib/nodus/caddy
}

:8080 {
	encode zstd gzip

	@wasm path *.wasm
	@assets path_regexp asset \.(js|mjs|wasm|css|map|json|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2)$

	# Older mime tables do not know wasm; the browser refuses it unless it is a module.
	header @wasm Content-Type application/wasm

	# The session is the shell's own state.
	handle /api/session* {
		reverse_proxy nodus-web:3000
	}

	# The OAuth callback is a page in the app: the code is exchanged client-side.
	handle /oauth/callback* {
		reverse_proxy nodus-web:3000
	}

	# Reads the shell performs on behalf of a visitor who is not signed in.
	handle /public-api/* {
		reverse_proxy nodus-web:3000
	}

	# The recommendation surface is its own process: a slow model must not queue behind a
	# request, and a restart of either must not restart the other.
	@feed path /api/v1/meta /api/v1/feed/* /api/v1/browse /api/v1/events /api/v1/feedback/* /api/v1/me /api/v1/sync/*
	handle @feed {
		reverse_proxy nodus-feed:3000
	}

	# Unfurling a post for a crawler is the same engine, not a page.
	handle /s/* {
		reverse_proxy nodus-feed:3000
	}

	handle /healthz {
		reverse_proxy nodus-api:3000
	}

	handle /readyz {
		reverse_proxy nodus-api:3000
	}

	# Lab-only alias: the server answers /healthz, while the lab contract (and up.sh)
	# probe /api/v1/healthz. It has to be matched before the /api catch-all.
	handle /api/v1/healthz {
		rewrite * /healthz
		reverse_proxy nodus-api:3000
	}

	# The instance's own icon and thumbnail, which the server renders rather than the bundle;
	# the asset rule below would look for them inside /srv/nodus.
	@images path /icon.svg /icon.png /favicon.ico /media/thumbnail.png
	handle @images {
		reverse_proxy nodus-api:3000
	}

	# A drive share is minted by the API; only the bytes belong to the media service, so the
	# API must own its path before the `/media/*` catch-all. See nodus-backend docs/09.
	handle /media/share/* {
		reverse_proxy nodus-api:3000
	}

	# Uploaded bytes are their own process: a large file read must not queue JSON behind it.
	handle /media/* {
		reverse_proxy nodus-media-worker:3003
	}

	# `flush_interval -1` is what makes an event stream arrive while it happens.
	@api path /oauth/* /auth/* /users/* /inbox* /statuses/* /.well-known/* /api/*
	handle @api {
		reverse_proxy nodus-api:3000 {
			flush_interval -1
		}
	}

	handle @assets {
		root * /srv/nodus
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Page routes are server-rendered; the app decides what to draw.
	handle {
		reverse_proxy nodus-web:3000 {
			flush_interval -1
		}
		header Cache-Control "no-store"
	}
}

# The lab's single origin. Same ownership as the reference AIO ingress, with TCP
# upstreams instead of unix sockets because every service is its own container.
#
# `handle` blocks are mutually exclusive and matched in the order they are written, which
# is why the two shell routes come before the `/api/*` catch-all, why `/media/share/*`
# comes before `/media/*`, and why the asset rule comes before the page fallback.
#
# Two entry points serve the same routes: http on 8080 for the host browser, and https on
# 443 for the federation peers. They share one route table because a route that works for
# a browser and not for a peer (or the reverse) is a federation bug, not a lab convenience.

{
	admin off
	# The :8080 site is a bare port, so there is nothing to redirect; keeping
	# certificate automation on is what lets `tls internal` issue for `nodus`. With
	# `off`, Caddy disables cert automation outright and the 443 listener comes up
	# without a connecting policy, answering the handshake with an internal error.
	auto_https disable_redirects
	storage file_system /var/lib/nodus/caddy
}

(routes) {
	encode zstd gzip

	@wasm path *.wasm
	@assets path_regexp asset \.(js|mjs|wasm|css|map|json|png|jpg|jpeg|gif|webp|svg|ico|woff|woff2)$

	# Older mime tables do not know wasm; the browser refuses it unless it is a module.
	header @wasm Content-Type application/wasm

	# The session is the shell's own state.
	handle /api/session* {
		reverse_proxy nodus-web:3000
	}

	# The OAuth callback is a page in the app: the code is exchanged client-side.
	handle /oauth/callback* {
		reverse_proxy nodus-web:3000
	}

	# Reads the shell performs on behalf of a visitor who is not signed in.
	handle /public-api/* {
		reverse_proxy nodus-web:3000
	}

	# The recommendation surface is its own process: a slow model must not queue behind a
	# request, and a restart of either must not restart the other.
	@feed path /api/v1/meta /api/v1/feed/* /api/v1/browse /api/v1/events /api/v1/feedback/* /api/v1/me /api/v1/sync/*
	handle @feed {
		reverse_proxy nodus-feed:3000
	}

	# Unfurling a post for a crawler is the same engine, not a page.
	handle /s/* {
		reverse_proxy nodus-feed:3000
	}

	handle /healthz {
		reverse_proxy nodus-api:3000
	}

	handle /readyz {
		reverse_proxy nodus-api:3000
	}

	# Lab-only alias: the server answers /healthz, while the lab contract (and up.sh)
	# probe /api/v1/healthz. It has to be matched before the /api catch-all.
	handle /api/v1/healthz {
		rewrite * /healthz
		reverse_proxy nodus-api:3000
	}

	# The instance's own icon and thumbnail, which the server renders rather than the bundle;
	# the asset rule below would look for them inside /srv/nodus.
	@images path /icon.svg /icon.png /favicon.ico /media/thumbnail.png
	handle @images {
		reverse_proxy nodus-api:3000
	}

	# A drive share is minted by the API; only the bytes belong to the media service, so the
	# API must own its path before the `/media/*` catch-all. See nodus-backend docs/09.
	handle /media/share/* {
		reverse_proxy nodus-api:3000
	}

	# Uploaded bytes are their own process: a large file read must not queue JSON behind it.
	handle /media/* {
		reverse_proxy nodus-media-worker:3003
	}

	# `flush_interval -1` is what makes an event stream arrive while it happens.
	@api path /oauth/* /auth/* /users/* /inbox* /statuses/* /.well-known/* /api/*
	handle @api {
		reverse_proxy nodus-api:3000 {
			flush_interval -1
		}
	}

	handle @assets {
		root * /srv/nodus
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Page routes are server-rendered; the app decides what to draw.
	handle {
		reverse_proxy nodus-web:3000 {
			flush_interval -1
		}
		header Cache-Control "no-store"
	}
}

# Host-side browsing: Playwright and up.sh probe http://127.0.0.1:$NODUS_HTTP_PORT.
# Keyed on the port alone, because the browser may arrive as 127.0.0.1, localhost or nodus.
:8080 {
	import routes
}

# The peers always address a remote origin as `https://<domain>`: Mastodon's
# `Webfinger#standard_url` builds it from the handle's domain, which carries no port, and
# Misskey does the same on delivery. So the name the origin advertises has to answer TLS
# on 443, which is the port both of them dial.
#
# `tls internal` is Caddy's own CA: the lab has no internet-facing name and cannot use
# ACME. The root of that CA is committed at peers/ca/root.crt and trusted inside the
# Mastodon and Misskey containers (see docs/peers.md, "TLS in the lab"). The authority
# lives on the nodus-data volume under /var/lib/nodus/caddy, so it survives a restart but
# not a `reset.sh`; the extracted root has to be re-taken after a reset.
https://nodus:443 {
	tls internal
	import routes
}

# The peers have the mirror-image gap. Each publishes an origin it does not itself serve on
# 443: Mastodon hard-codes `https` in every ActivityPub id (`ActivityPub::TagManager#uri_for`)
# and builds every other URL from `WEB_DOMAIN`, which cannot carry a port; Misskey builds all
# of them from its `url`. Both answer plain http on their own listen port, so the origin
# cannot fetch a key document from either name until something terminates TLS for it.
# Caddy owns the two names on the `nodus-lab` network and proxies to the port each peer
# really listens on: Mastodon on 80 (see compose.peers.yml, `rails server -p 80`) and
# Misskey on 18082 (peers/misskey/default.yml, `port`).
#
# These blocks deliberately do not `import routes`: the route table is the origin's, and a
# peer name must never resolve an origin path. Like the origin's 443 site, they are not
# published on the host — peers dial them by container name.
https://mastodon.test {
	tls internal
	encode zstd gzip
	reverse_proxy mastodon:80
}

https://misskey.test {
	tls internal
	encode zstd gzip
	reverse_proxy misskey:18082
}
